################################################################################
# SNP Chain - 附加验证者节点配置（非创世节点）
# 版本: 1.0.0
#
# 仅用于加入已有网络的【额外验证者节点】，不要用于第一个/创世节点
#
# 重要步骤：
# 1. 复制本文件为 validator.env
# 2. 逐项检查并修改所有参数
# 3. 从现有网络获取 genesis.json
# 4. 从运营方获取种子节点和持久连接节点信息
################################################################################

################################################################################
# 基本配置
################################################################################

# 链ID（必须与现有网络完全一致）
CHAIN_ID="snp-mainnet-1"

# 验证者显示名称（委托人可见）
VALIDATOR_MONIKER="my-additional-validator"

# 链数据目录
CHAIN_HOME="$HOME/.snp"

# seid 可执行文件路径
SEID_BINARY="$HOME/go/bin/seid"

################################################################################
# 密钥管理 - 极重要安全设置
################################################################################

# 密钥环后端：推荐 "file"（密码加密）或 "os"（系统密钥环），生产绝不能用 "test"
KEYRING_BACKEND="file"

# 验证者密钥名称
VALIDATOR_KEY_NAME="validator"

# 是否创建新密钥（true=新建，false=导入已有密钥）
CREATE_NEW_KEY="true"

################################################################################
# 创世文件配置 - 必须正确
################################################################################

# 方式1：从URL下载（推荐）
GENESIS_FILE_URL="https://example.com/genesis.json"

# 方式2：使用本地文件（若使用URL则留空）
GENESIS_FILE_PATH=""

################################################################################
# 网络连接配置 - 决定能否同步
################################################################################

# 种子节点（帮助发现其他节点，格式：node_id@ip:port）
SEEDS="node1_id@seed1.example.com:26656,node2_id@seed2.example.com:26656"

# 持久连接节点（推荐至少2-3个可靠节点）
PERSISTENT_PEERS="peer1_id@node1.example.com:26656,peer2_id@node2.example.com:26656"

# 获取node_id方法：在已同步节点执行：
# seid tendermint show-node-id --home ~/.snp

MAX_INBOUND_PEERS="40"
MAX_OUTBOUND_PEERS="10"

################################################################################
# 状态同步（State Sync）- 强烈推荐快速加入网络
################################################################################

# 开启状态同步（几小时内同步完成，而非几天）
ENABLE_STATE_SYNC="true"

# 状态同步用的RPC节点（至少2个，可靠的公共RPC）
STATE_SYNC_RPC_SERVERS="rpc1.example.com:26657,rpc2.example.com:26657"

# 可选：手动指定信任高度和哈希（留空会自动获取）
STATE_SYNC_TRUST_HEIGHT=""
STATE_SYNC_TRUST_HASH=""

################################################################################
# 验证者参数
################################################################################

# 最小单位
DENOM="usnp"

# 创建验证者时自抵押数量（单位：usnp）
VALIDATOR_STAKE="1000000000"   # 约1000 SNP

# 佣金设置
COMMISSION_RATE="0.10"              # 10%
COMMISSION_MAX_RATE="0.20"          # 最高20%
COMMISSION_MAX_CHANGE_RATE="0.01"   # 每日最大调整1%

# 最低自抵押
MIN_SELF_DELEGATION="1"

################################################################################
# 性能配置
################################################################################

CONCURRENCY_WORKERS="200"

################################################################################
# RPC/API 配置
################################################################################

ENABLE_API="true"
RPC_LISTEN_ADDRESS="127.0.0.1:26657"
GRPC_ADDRESS="127.0.0.1:9090"
CORS_ALLOWED_ORIGINS='[]'

################################################################################
# 监控配置
################################################################################

PROMETHEUS_LISTEN_ADDRESS="127.0.0.1:26660"
LOG_LEVEL="error"   # 生产推荐error

################################################################################
# 重要提醒（启动前必做）
################################################################################
# 1. 必须拿到正确的 genesis.json 并验证哈希
# 2. 种子节点和持久节点必须准确
# 3. 确保账户有足够 usnp 用于自抵押+手续费
# 4. 开启状态同步（几小时同步完成）
# 5. 防火墙放行 26656 端口
# 6. 备份好 priv_validator_key.json

################################################################################
# 完整操作流程
################################################################################
# 1. 执行脚本
#    ./scripts/setup_validator_node.sh
#
# 2. 启动节点
#    sudo systemctl start snp-node
#
# 3. 等待完全同步（catching_up: false）
#    curl -s localhost:26657/status | jq '.result.sync_info'
#
# 4. 查看验证者地址
#    seid keys show validator -a --home ~/.snp
#
# 5. 向该地址转入足够 usnp（≥1000000000 + 手续费）
#
# 6. 创建验证者（同步完成且有余额后执行）
#    seid tx staking create-validator \
#      --amount=1000000000usnp \
#      --pubkey=$(seid tendermint show-validator --home ~/.snp) \
#      --moniker="my-additional-validator" \
#      --chain-id=snp-mainnet-1 \
#      --commission-rate="0.10" \
#      --commission-max-rate="0.20" \
#      --commission-max-change-rate="0.01" \
#      --min-self-delegation="1" \
#      --from=validator \
#      --keyring-backend=file \
#      --home ~/.snp
#
# 7. 检查验证者是否激活
#    seid query staking validator $(seid keys show validator --bech val -a --home ~/.snp)
#
################################################################################

全部已完整翻译为简洁中文，直接保存为 validator.env 即可使用。