################################################################################
# SNP Chain - 生产环境配置
# 版本: 1.0.0
#
# 重要提醒：
# 1. 复制本文件为 production.env
# 2. 所有参数必须逐项审核并修改
# 3. 此文件绝不能提交到 git 等版本控制系统
################################################################################

################################################################################
# 基本链配置
################################################################################

# 链ID - 必须全局唯一
CHAIN_ID="snp-mainnet-1"

# 验证者节点名称（显示名称）
VALIDATOR_MONIKER="my-validator-node"

# 验证者密钥名称
VALIDATOR_KEY_NAME="validator"

# 链数据主目录
CHAIN_HOME="$HOME/.snp"

# seid 可执行文件路径
SEID_BINARY="$HOME/go/bin/seid"

################################################################################
# 密钥管理 - 极重要安全设置
################################################################################

# 密钥环后端：推荐 "file"（文件+密码加密）或 "os"（系统密钥环）
# 生产环境严禁使用 "test"！
KEYRING_BACKEND="file"

# 是否创建新密钥（true=新建，false=导入已有密钥）
CREATE_NEW_KEY="true"

################################################################################
# 通证经济参数 - 必须仔细核对
################################################################################

# 最小单位（base denom）
DENOM="usnp"
# 前端显示单位
DENOM_DISPLAY="SNP"
# 符号
DENOM_SYMBOL="SNP"

# 创世账户初始余额（单位：usnp，6位小数时 1000000000000 = 100万 SNP）
GENESIS_ACCOUNT_BALANCE="1000000000000"

# 验证者初始自抵押金额（建议占总量的 0.1%-1%）
VALIDATOR_STAKE="1000000000"

# 初始投票权力（与自抵押金额一致）
VALIDATOR_POWER="1000000000"

# 佣金率（10%）
COMMISSION_RATE="0.10"
# 最高允许佣金率（20%）
COMMISSION_MAX_RATE="0.20"
# 每日最大佣金调整幅度（1%）
COMMISSION_MAX_CHANGE_RATE="0.01"

# 最低自抵押数量（最小 1 usnp）
MIN_SELF_DELEGATION="1"

################################################################################
# 通证释放计划
################################################################################

# 是否开启线性释放
ENABLE_TOKEN_RELEASE="true"

# 释放周期（天），1460 ≈ 4年
TOKEN_RELEASE_DAYS="1460"

# 总释放数量（单位：usnp）
TOKEN_RELEASE_AMOUNT="1000000000000"

################################################################################
# 治理参数 - 主网推荐值
################################################################################

# 提案最长存款期（14天）
GOV_DEPOSIT_PERIOD="1209600s"

# 普通提案投票期（7天）
GOV_VOTING_PERIOD="604800s"

# 紧急提案投票期（1天）
GOV_EXPEDITED_VOTING_PERIOD="86400s"

################################################################################
# 预言机参数
################################################################################

# 价格投票周期（单位：块，建议 30-100）
ORACLE_VOTE_PERIOD="30"

# 预言机白名单（需要价格喂价的代币）
ORACLE_WHITELIST='[
    {"name": "ueth"},
    {"name": "ubtc"},
    {"name": "uusdc"},
    {"name": "uusdt"},
    {"name": "uosmo"},
    {"name": "uatom"},
    {"name": "usnp"}
]'

################################################################################
# 经济参数
################################################################################

# 社区税（2%）
COMMUNITY_TAX="0.020000000000000000"

# 解绑期（21天，主网标准）
UNBONDING_TIME="1814400s"

################################################################################
# 共识与性能参数
################################################################################

# 每块最大 gas（影响吞吐量）
MAX_GAS_PER_BLOCK="50000000"

# 单笔交易最大 gas
MAX_GAS_WANTED="50000000"

# 单验证者最大投票权占比（强烈建议 ≤33%，防止中心化）
MAX_VOTING_POWER_RATIO="0.330000000000000000"

# 目标出块时间（5秒）
BLOCK_TIME="5000ms"
BLOCK_TIME_SECONDS="5s"

# 并行处理线程数（根据 CPU 核心数调整，推荐 100-500）
CONCURRENCY_WORKERS="200"

################################################################################
# 网络配置
################################################################################

# 种子节点（格式：node_id@ip:port，多节点用逗号分隔）
SEEDS=""

# 持久连接节点（同上）
PERSISTENT_PEERS=""

# 最大入站连接数
MAX_INBOUND_PEERS="40"

# 最大出站连接数
MAX_OUTBOUND_PEERS="10"

################################################################################
# RPC / API 配置（安全重点）
################################################################################

# RPC 监听地址（推荐仅本机，公网请加 nginx+TLS 反向代理）
RPC_LISTEN_ADDRESS="127.0.0.1:26657"

# gRPC 监听地址
GRPC_ADDRESS="127.0.0.1:9090"

# 允许跨域的域名（前端域名）
CORS_ALLOWED_ORIGINS='[]'

################################################################################
# 监控与日志
################################################################################

# Prometheus 指标暴露端口
PROMETHEUS_LISTEN_ADDRESS="127.0.0.1:26660"

# 日志级别（生产推荐 "error"，减少磁盘占用）
LOG_LEVEL="error"