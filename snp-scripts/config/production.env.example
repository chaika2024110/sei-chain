################################################################################
# SNP Chain - 生产环境配置文件
# 版本: 1.0.0
#
# 重要提示:
# 1. 将此文件复制为 production.env
# 2. 仔细审核并自定义下面的所有值
# 3. 保护好此文件，永远不要提交到版本控制系统
################################################################################

################################################################################
# 基本链配置
################################################################################

# 链 ID - 您的网络的唯一标识符
CHAIN_ID="snp-chain"

# 验证者配置
VALIDATOR_MONIKER="gen-validator-node"
VALIDATOR_KEY_NAME="validator"

# 链主目录
CHAIN_HOME="$HOME/.snp"

# seid 二进制文件路径
SEID_BINARY="$HOME/go/bin/seid"

################################################################################
# 密钥管理 - 关键安全设置
################################################################################

# 密钥环后端: 'file' (密码加密) 或 'os' (系统密钥环)
# 生产环境中永远不要使用 'test'！
KEYRING_BACKEND="file"

# 创建新密钥或导入现有密钥
CREATE_NEW_KEY="true"  # 如果导入现有密钥设置为 false

################################################################################
# 代币经济学配置 - 仔细审核
################################################################################

# 基础单位（最小单位）
DENOM="usnp"
DENOM_DISPLAY="SNP"
DENOM_SYMBOL="SNP"

# 创世账户余额（基础单位）
# 示例: 10000000000000000 = 10,000,000,000 SNP（假设 6 位小数 100亿）
# 重要提示: 根据您的代币经济学设置！
GENESIS_ACCOUNT_BALANCE="10000000000000000"

# 验证者初始质押（基础单位）
# 推荐: 总供应量的 0.1% - 1%
# 示例: 1000000000 = 1,000 SNP
VALIDATOR_STAKE="1000000000"

# 验证者账户余额（基础单位）
# 这是验证者账户在创世时的总余额（包括质押金额）
# 推荐: VALIDATOR_STAKE 的 1.5-2 倍（预留 gas 费用）
VALIDATOR_BALANCE="10000000000000000"

# 验证者投票权
# 这应该反映相对于总供应量的质押比例
VALIDATOR_POWER="1000000000"

# 佣金费率（小数形式，例如 0.10 = 10%）
COMMISSION_RATE="0.10"
COMMISSION_MAX_RATE="0.20"
COMMISSION_MAX_CHANGE_RATE="0.01"

# 最小自我委托
MIN_SELF_DELEGATION="1"

################################################################################
# 创世账户配置
################################################################################
# 格式: "地址:余额"（不含代币单位）
# 余额以基础单位（usnp）计算
# 示例:
#   GENESIS_ACCOUNTS=(
#       "snp1abc123...:1000000000000"   # 1,000,000 SNP
#       "snp1def456...:500000000000"    # 500,000 SNP
#   )
GENESIS_ACCOUNTS=(
    # 在此添加创世账户
    # "snp1address1:1000000000000"
    # "snp1address2:500000000000"
)

################################################################################
# 代币释放计划
################################################################################
# 格式: "地址:开始时间:结束时间:金额"
# 时间使用 Unix 时间戳（秒）
# 金额以基础单位计算
# 示例:
#   TOKEN_VESTING_SCHEDULES=(
#       "snp1team...:1704067200:1830297600:10000000000000"   # 4年释放
#       "snp1investor...:1735689600:1830297600:5000000000000"  # 1年悬崖+3年释放
#   )
TOKEN_VESTING_SCHEDULES=(
    # 在此添加释放计划
    # "snp1address:1704067200:1830297600:10000000000000"
)

# 计算时间戳辅助工具:
# date -d "2024-01-01 00:00:00 UTC" +%s
# 或访问: https://www.unixtimestamp.com/

################################################################################
# 治理参数 - 生产环境值
################################################################################

# 投票周期（秒）
# 推荐: 主网 3-7 天
VOTING_PERIOD="604800"  # 7 天

# 最大存款周期（达到最小存款所需时间）
# 推荐: 主网 7-14 天
DEPOSIT_PERIOD="1209600"  # 14 天

# 最小存款金额（基础单位）
# 这是提案进入投票阶段所需的最小存款
# 推荐: 代币总供应量的 0.001% - 0.01%
MIN_DEPOSIT="1000000000"  # 1,000 SNP

# 加速投票周期（紧急提案）
# 推荐: 1-2 天
EXPEDITED_VOTING_PERIOD="86400"  # 1 天

################################################################################
# Oracle 参数
################################################################################

# 投票周期（区块数，不是秒）
# 推荐: 生产环境 30-100 个区块
ORACLE_VOTE_PERIOD="30"

# Oracle 投票阈值（小数形式）
# 这是价格被接受所需的最小投票比例
# 推荐: 0.50 (50%) 或 0.67 (67%)
ORACLE_VOTE_THRESHOLD="0.67"

# Oracle 白名单（JSON 格式）
# 添加需要价格反馈的代币
ORACLE_WHITELIST='[
    {"name": "ueth"},
    {"name": "ubtc"},
    {"name": "uusdc"},
    {"name": "uusdt"},
    {"name": "uosmo"},
    {"name": "uatom"},
    {"name": "usnp"}
]'

################################################################################
# 经济参数
################################################################################

# 社区税（小数字符串形式）
# 推荐: 社区池 2-5%
# 示例: "0.020000000000000000" = 2%
COMMUNITY_TAX="0.000000000000000000"

# 解绑时间（秒）
# 推荐: 主网 21 天（1814400秒）
UNBONDING_TIME="1814400"

################################################################################
# 通胀参数
################################################################################

# 通胀率变化速度
# 这决定了通胀率调整的速度
# 推荐: 0.13（默认 Cosmos 值）
INFLATION_RATE_CHANGE="0.130000000000000000"

# 最大通胀率
# 推荐: 0.20 (20%)
INFLATION_MAX="0.200000000000000000"

# 最小通胀率
# 推荐: 0.07 (7%)
INFLATION_MIN="0.070000000000000000"

################################################################################
# 共识参数
################################################################################

# 每个区块的最大 Gas
# 根据预期交易量调整
MAX_GAS="100000000"

# 单笔交易的最大 Gas
MAX_GAS_WANTED="100000000"

# 最大区块大小（字节）
# 推荐: 22020096 字节（约 22 MB）
MAX_BLOCK_SIZE="22020096"

# 最大投票权比例（防止单个验证者主导）
# 关键安全设置
# 推荐: 0.33 (33%) - 防止任何单个验证者拥有 >33% 的权力
MAX_VOTING_POWER_RATIO="0.330000000000000000"

# 最大验证者数量
# 这是可以参与共识的验证者数量上限
# 推荐: 50-150（根据网络规模）
MAX_VALIDATORS="20"

################################################################################
# 区块时间配置
################################################################################

# 区块时间（毫秒）
# 推荐: 生产环境 5000-6000ms（5-6秒）
BLOCK_TIME_IOTA_MS="1000"

# 区块时间（秒）- 用于某些配置
BLOCK_TIME_SECONDS="5"

################################################################################
# 性能配置
################################################################################

# 并发工作线程数（用于并行交易处理）
# 根据服务器 CPU 核心数调整
# 推荐: 生产环境 100-500
CONCURRENCY_WORKERS="200"

################################################################################
# 网络配置
################################################################################

# 种子节点（node_id@ip:port 的逗号分隔列表）
# 在此添加您的种子节点
SEEDS=""

# 持久节点（node_id@ip:port 的逗号分隔列表）
# 在此添加您的持久节点
PERSISTENT_PEERS=""

# 最大入站对等节点数量
MAX_INBOUND_PEERS="40"

# 最大出站对等节点数量
MAX_OUTBOUND_PEERS="10"

################################################################################
# RPC/API 配置
################################################################################

# 启用 API 端点
# 设置为 true 以启用 REST API
# 警告: 仅在使用反向代理和适当安全措施时启用
ENABLE_API="true"

# RPC 监听地址
# 使用 127.0.0.1 仅限本地访问（推荐使用反向代理）
# 只有在您知道自己在做什么时才使用 0.0.0.0
RPC_LISTEN_ADDRESS="127.0.0.1:26657"

# gRPC 地址
GRPC_ADDRESS="127.0.0.1:9090"

# CORS 允许的源（JSON 数组格式）
# 示例: '["https://explorer.example.com", "https://wallet.example.com"]'
CORS_ALLOWED_ORIGINS='[]'

################################################################################
# 监控配置
################################################################################

# Prometheus 指标端点
PROMETHEUS_LISTEN_ADDRESS="127.0.0.1:26660"

# 日志级别: debug, info, error, none
# 生产环境使用 'error' 以减少日志量
LOG_LEVEL="error"

################################################################################
# 安全检查清单
################################################################################
#
# 部署到生产环境前，确保:
#
# [ ] 已审核并自定义所有代币经济学参数
# [ ] 设置了适当的治理周期（不是测试值）
# [ ] 配置了安全的密钥环后端（不是 'test'）
# [ ] 已安全备份验证者密钥
# [ ] 配置了防火墙规则
# [ ] 设置了监控和告警
# [ ] 测试了备份和恢复程序
# [ ] 审核了 max_voting_power_ratio（防止中心化）
# [ ] 设置了适当的佣金费率
# [ ] 配置了种子节点和持久节点
# [ ] 限制了 RPC/API 访问（使用反向代理）
# [ ] 设置了 DDoS 防护
# [ ] 为公共端点配置了 SSL/TLS
# [ ] 设置了日志轮转
# [ ] 规划了升级和维护窗口
#
################################################################################

################################################################################
# 备份提醒
################################################################################
#
# 关键文件备份:
# 1. $CHAIN_HOME/config/priv_validator_key.json  (最重要！)
# 2. $CHAIN_HOME/config/node_key.json
# 3. 您的密钥环文件（位置取决于 keyring-backend）
# 4. $CHAIN_HOME/config/genesis.json
# 5. $CHAIN_HOME/config/config.toml
# 6. $CHAIN_HOME/config/app.toml
#
# 将备份存储在多个安全位置:
# - 加密的 USB 驱动器
# - 硬件安全模块（HSM）
# - 安全的云存储（加密）
# - 离线系统
#
################################################################################

################################################################################
# 代币经济学示例
################################################################################
#
# 这是一个典型的代币分配示例（总供应量 100,000,000 SNP）:
#
# 1. 团队 (30%): 30,000,000 SNP - 4年线性释放
#    TOKEN_VESTING_SCHEDULES+=(
#        "snp1team...:1704067200:1830297600:30000000000000"
#    )
#
# 2. 投资人 (20%): 20,000,000 SNP - 1年悬崖 + 3年释放
#    TOKEN_VESTING_SCHEDULES+=(
#        "snp1investor...:1735689600:1830297600:20000000000000"
#    )
#
# 3. 公开销售 (15%): 15,000,000 SNP - 无锁定
#    GENESIS_ACCOUNTS+=(
#        "snp1public...:15000000000000"
#    )
#
# 4. 社区储备 (25%): 25,000,000 SNP - 5年线性释放
#    TOKEN_VESTING_SCHEDULES+=(
#        "snp1community...:1704067200:1861833600:25000000000000"
#    )
#
# 5. 流动性 (10%): 10,000,000 SNP - 无锁定
#    GENESIS_ACCOUNTS+=(
#        "snp1liquidity...:10000000000000"
#    )
#
################################################################################