################################################################################
# SNP Chain - Cron 定时任务配置
# 
# 安装方法:
# 1. 编辑此文件，替换为实际路径
# 2. 运行: crontab -e
# 3. 将下面的定时任务复制粘贴进去
################################################################################

# 为 cron 任务设置 PATH
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin

################################################################################
# 每日备份 (凌晨 3 点)
################################################################################
# 运行节点配置和密钥的自动备份
0 3 * * * /home/YOUR_USERNAME/snp-production-deployment/scripts/backup.sh >> /home/YOUR_USERNAME/snp-production-deployment/logs/backup.log 2>&1

################################################################################
# 每 5 分钟健康检查
################################################################################
# 监控节点健康状态，如果检测到问题则发送告警
*/5 * * * * /home/YOUR_USERNAME/snp-production-deployment/scripts/health_check.sh >> /home/YOUR_USERNAME/snp-production-deployment/logs/health_check.log 2>&1

################################################################################
# 每日日志轮转 (凌晨 2 点)
################################################################################
# 轮转和压缩旧日志文件以节省磁盘空间
0 2 * * * find /home/YOUR_USERNAME/.snp/logs -name "*.log" -type f -size +100M -exec gzip {} \;

################################################################################
# 每小时磁盘空间检查
################################################################################
# 如果磁盘空间不足则发送告警
0 * * * * df -h /home/YOUR_USERNAME/.snp | tail -1 | awk '{if ($5+0 > 85) print "警告: 磁盘使用率达到 " $5}' | mail -s "SNP 节点磁盘空间告警" YOUR_EMAIL@example.com

################################################################################
# Prometheus 指标导出 (可选)
################################################################################
# 如果使用 Prometheus，确保指标端点可访问
# 无需 cron - Prometheus 直接从端点抓取指标

################################################################################
# 每周完整备份到远程位置 (周日凌晨 4 点)
################################################################################
# 创建包含链数据的完整备份并上传到远程服务器
0 4 * * 0 BACKUP_CHAIN_DATA=true REMOTE_BACKUP=true /home/YOUR_USERNAME/snp-production-deployment/scripts/backup.sh >> /home/YOUR_USERNAME/snp-production-deployment/logs/weekly_backup.log 2>&1

################################################################################
# 每周清理旧备份 (周日凌晨 5 点)
################################################################################
# 删除 30 天前的旧备份
0 5 * * 0 find /home/YOUR_USERNAME/snp_backups -name "backup_*.tar.gz*" -type f -mtime +30 -delete

################################################################################
# 注意事项:
################################################################################
# 
# 1. 将 YOUR_USERNAME 替换为您的实际用户名
# 2. 将 YOUR_EMAIL@example.com 替换为您的邮箱地址
# 3. 创建日志目录: mkdir -p /home/YOUR_USERNAME/snp-production-deployment/logs
# 4. 设置脚本可执行权限: chmod +x /home/YOUR_USERNAME/snp-production-deployment/scripts/*.sh
# 5. 在设置 cron 之前手动测试每个脚本
# 6. 定期监控日志: tail -f /home/YOUR_USERNAME/snp-production-deployment/logs/*.log
# 
################################################################################
